# Use a Vercel-connected private Blob store for preview and production.
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN is added automatically by an existing token-based store connection.
# Never commit a Blob token, workspace PIN, or session secret.
# The shared access PIN must contain exactly six digits.
MIGRATION_ACCESS_PIN=
MIGRATION_SESSION_SECRET=

# Optional local-only storage. This is disabled in production.
# MIGRATION_LOCAL_STORE_DIR=/tmp/postalytics-local-workspace
